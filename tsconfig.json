      "@spartan-ng/helm/separator": [
        "./src/app/components/separator/src/index.ts"
      ],
      "@spartan-ng/helm/sheet": [
        "./src/app/components/sheet/src/index.ts"
      ],
      "@spartan-ng/helm/skeleton": [
        "./src/app/components/skeleton/src/index.ts"
      ],
      "@spartan-ng/helm/tooltip": [
        "./src/app/components/tooltip/src/index.ts"
