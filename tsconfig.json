      ],
      "@spartan-ng/helm/select": [
        "./src/app/components/select/src/index.ts"
      ],
      "@spartan-ng/helm/textarea": [
        "./src/app/components/textarea/src/index.ts"
      ],
      "@spartan-ng/helm/label": [
        "./src/app/components/label/src/index.ts"
      ],
      "@spartan-ng/helm/card": [
        "./src/app/components/card/src/index.ts"
      ],
